{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "gcc12",
            "displayName": "GCC 12.3.0 x86_64-linux-gnu",
            "description": "Using compilers: C = /usr/bin/gcc-12",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/bin/gcc-12",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "vs-2017",
            "displayName": "Visual Studio Community 2022 Release - amd64_x86",
            "description": "Using compilers for Visual Studio 17 2022 (x64_x86 architecture)",
            "generator": "Visual Studio 17 2022",
            "toolset": "host=x64",
            "architecture": "win32",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc12",
            "configurePreset": "gcc12"
        },
        {
            "name": "vs-2017-debug",
            "displayName": "Visual Studio Community 2022 Release - amd64_x86 - Debug",
            "configurePreset": "vs-2017",
            "configuration": "Debug"
        }
    ]
}